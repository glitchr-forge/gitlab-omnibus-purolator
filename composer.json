{
    "name": "omnibus/purolator",
    "type": "library",
    "description": "Omnibus Purolator: estimates, shipments and labels, tracking - the E-Ship Web Services (SOAP).",
    "keywords": [
        "shipping",
        "carrier",
        "omnibus",
        "purolator"
    ],
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "glitchr/omnibus": "^2.0@dev",
        "symfony/http-client-contracts": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "suggest": {
        "symfony/http-client": "The HTTP client the carrier talks through"
    },
    "autoload": {
        "psr-4": {
            "Omnibus\\Purolator\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnibus\\Purolator\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
